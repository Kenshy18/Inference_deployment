{
  "name": "polygon_from_tracked",
  "stages": [
    {
      "id": "polygon_optimization",
      "implementation": "approximation.polygon.production_v22",
      "options": {
        "interval_frames": 3,
        "max_gap": 30,
        "border_expand": true,
        "endpoint_extend": true
      }
    },
    {
      "id": "exact_evaluation",
      "implementation": "evaluation.mask_iou"
    },
    {
      "id": "output_validation",
      "implementation": "artifacts.validate"
    }
  ]
}
