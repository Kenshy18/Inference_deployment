{
  "name": "ellipse_from_tracked",
  "stages": [
    {
      "id": "ellipse_approximation",
      "implementation": "approximation.ellipse.production",
      "options": {
        "device": "cpu"
      }
    },
    {
      "id": "keyframe_selection",
      "implementation": "keyframes.ellipse.dense",
      "options": {
        "target_ratio": 0.3333333333333333,
        "dense_recall_target": 0.96
      }
    },
    {
      "id": "mask_gap_fill",
      "implementation": "gap_fill.ellipse.linear",
      "options": {
        "max_gap": 30
      }
    },
    {
      "id": "exact_evaluation",
      "implementation": "evaluation.ellipse.exact"
    },
    {
      "id": "sqlite_export",
      "implementation": "artifacts.union_sqlite"
    },
    {
      "id": "output_validation",
      "implementation": "artifacts.validate"
    }
  ]
}
