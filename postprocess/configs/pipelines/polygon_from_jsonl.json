{
  "name": "polygon_from_jsonl",
  "stages": [
    {
      "id": "normalization",
      "implementation": "preprocessing.normalize"
    },
    {
      "id": "score_policy",
      "implementation": "preprocessing.score_policy",
      "options": {
        "score_min": 0.35
      }
    },
    {
      "id": "nms",
      "implementation": "nms.adaptive"
    },
    {
      "id": "cut_detection",
      "implementation": "cut_detection.video",
      "options": {
        "enabled": true,
        "method": "high_precision"
      }
    },
    {
      "id": "tracking",
      "implementation": "tracking.greedy",
      "options": {
        "remove_short_tracks_max_frames": 10
      }
    },
    {
      "id": "polygon_approximation",
      "implementation": "approximation.polygon.rdp"
    },
    {
      "id": "keyframe_selection",
      "implementation": "keyframes.polygon.interval",
      "options": {
        "interval_frames": 3
      }
    },
    {
      "id": "mask_gap_fill",
      "implementation": "gap_fill.polygon.linear"
    },
    {
      "id": "exact_evaluation",
      "implementation": "evaluation.mask_iou"
    },
    {
      "id": "output_validation",
      "implementation": "artifacts.validate"
    }
  ]
}
