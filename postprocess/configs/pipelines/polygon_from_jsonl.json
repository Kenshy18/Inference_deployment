{
  "name": "polygon_from_jsonl",
  "stages": [
    {
      "id": "normalization",
      "implementation": "preprocessing.normalize"
    },
    {
      "id": "score_policy",
      "implementation": "preprocessing.score_policy",
      "options": {
        "score_min": 0.35
      }
    },
    {
      "id": "nms",
      "implementation": "nms.production_v3"
    },
    {
      "id": "cut_detection",
      "implementation": "cut_detection.video",
      "options": {
        "enabled": true,
        "method": "high_precision"
      }
    },
    {
      "id": "tracking",
      "implementation": "tracking.greedy",
      "options": {
        "remove_short_tracks_max_frames": 10
      }
    },
    {
      "id": "polygon_optimization",
      "implementation": "production.polygon_v3_cpu",
      "options": {
        "target_interval": 6,
        "interval_evaluation": "native_exact"
      }
    },
    {
      "id": "exact_evaluation",
      "implementation": "evaluation.mask_iou"
    },
    {
      "id": "output_validation",
      "implementation": "artifacts.validate"
    }
  ]
}
