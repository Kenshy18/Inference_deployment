{
  "name": "legacy_production_kpi_benchmark",
  "stages": [
    {
      "id": "normalization",
      "implementation": "preprocessing.raw_sqlite"
    },
    {
      "id": "score_policy",
      "implementation": "preprocessing.score_policy",
      "options": {
        "score_min": 0.3
      }
    },
    {
      "id": "nms",
      "implementation": "nms.adaptive"
    },
    {
      "id": "cut_detection",
      "implementation": "cut_detection.video",
      "options": {
        "enabled": false
      }
    },
    {
      "id": "tracking",
      "implementation": "tracking.greedy",
      "options": {
        "remove_short_tracks_max_frames": 10
      }
    },
    {
      "id": "polygon_optimization",
      "implementation": "approximation.polygon.production_v22",
      "options": {
        "interval_frames": 6,
        "max_gap": 30,
        "num_workers": 4
      }
    },
    {
      "id": "exact_evaluation",
      "implementation": "evaluation.mask_iou"
    },
    {
      "id": "output_validation",
      "implementation": "artifacts.validate"
    }
  ]
}
