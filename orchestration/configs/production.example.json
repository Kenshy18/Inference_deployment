{
  "schema_version": 1,
  "input_video": "/path/to/input.mp4",
  "output_root": "/path/to/runs/example",
  "execution": {
    "runtime_python": "/home/kenshin/.local/share/video-mask-runtime/envs/production/bin/python3.10",
    "resume": false
  },
  "inference": {
    "enabled": true,
    "mode": "segmentation-face",
    "segmentation_model": "dinov3_codino",
    "segmentation_backend": "tensorrt-fast",
    "face_model": "face_dino_v2",
    "face_classes": ["Face", "Head"],
    "device": "cuda:0",
    "warmup_frames": 0,
    "face_warmup_iterations": 3,
    "parallel_models": false,
    "parallel_model_stagger_seconds": 0.0,
    "fast_sqlite": false
  },
  "postprocess": {
    "enabled": true,
    "export_legacy_sqlite": false,
    "shape_mode": "ellipse",
    "score_min": 0.35,
    "cut_detect": true,
    "cut_method": "high_precision",
    "precompute_cuts_during_inference": true,
    "remove_short_tracks_max_frames": 10,
    "keyframe_interval": 3,
    "face_mask_target": "eyes",
    "eye_mask_shape": "ellipse",
    "minimum_eye_confidence": 0.35,
    "device": "auto",
    "extra_args": [
      "--k2-batch-size", "128",
      "--k2-prep-workers", "4",
      "--k2-cudnn-benchmark", "on",
      "--k2-tf32", "off"
    ]
  },
  "overlay": {
    "enabled": true,
    "execution_mode": "cpu",
    "raw": true,
    "tracked": true,
    "final": true,
    "faces": true,
    "final_include_faces": true,
    "mask_alpha": 0.32,
    "show_labels": true,
    "h264_crf": 18,
    "h264_preset": "veryfast",
    "nvenc_cq": 18,
    "workers": 6,
    "cpu_workers": 0,
    "copy_audio": false,
    "target_bitrate_mbps": null,
    "nvenc_preset": "p5",
    "nvenc_gpu": 0,
    "faststart": false,
    "start_frame": 0,
    "end_frame": null,
    "progress_every": 300
  }
}
